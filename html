<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ryanair Keyboard Accessibility Prototype</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f0f2f5;
      color: #1a1a1a;
      min-height: 100vh;
      padding: 2rem 1rem;
    }

    .page-header {
      text-align: center;
      margin-bottom: 2rem;
    }
    .page-header .badge {
      display: inline-block;
      background: #073590;
      color: #fff;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 20px;
      margin-bottom: 10px;
    }
    .page-header h1 {
      font-size: 22px;
      font-weight: 700;
      color: #073590;
      margin-bottom: 6px;
    }
    .page-header p {
      font-size: 14px;
      color: #555;
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.6;
    }

    .container {
      max-width: 780px;
      margin: 0 auto;
    }

    .toggle-bar {
      display: flex;
      justify-content: center;
      margin-bottom: 1.5rem;
      border: 1.5px solid #cbd5e1;
      border-radius: 10px;
      overflow: hidden;
      width: fit-content;
      margin-left: auto;
      margin-right: auto;
      background: #fff;
    }
    .toggle-btn {
      padding: 10px 32px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      background: transparent;
      color: #666;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .toggle-btn.active {
      background: #073590;
      color: #fff;
    }
    .toggle-btn .dot-bad { width: 8px; height: 8px; border-radius: 50%; background: #E24B4A; display: inline-block; }
    .toggle-btn .dot-good { width: 8px; height: 8px; border-radius: 50%; background: #639922; display: inline-block; }

    .screen { display: none; }
    .screen.active { display: block; }

    .screen-label {
      text-align: center;
      font-size: 12px;
      color: #777;
      margin-bottom: 10px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .kbd {
      display: inline-block;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      padding: 1px 6px;
      font-family: monospace;
      font-size: 11px;
      color: #333;
    }

    .browser-frame {
      border: 1.5px solid #cbd5e1;
      border-radius: 14px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }
    .browser-bar {
      background: #f1f5f9;
      border-bottom: 1px solid #e2e8f0;
      padding: 9px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .browser-dots { display: flex; gap: 5px; }
    .bdot { width: 11px; height: 11px; border-radius: 50%; }
    .bdot.r { background: #fc6058; }
    .bdot.y { background: #fec02f; }
    .bdot.g { background: #2aca3e; }
    .browser-url {
      flex: 1;
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 5px;
      padding: 4px 12px;
      font-size: 12px;
      color: #555;
    }

    /* Ryanair UI */
    .ryanair-nav {
      background: #073590;
      padding: 0 16px;
      display: flex;
      gap: 2px;
    }
    .r-tab {
      color: rgba(255,255,255,0.65);
      font-size: 12px;
      font-weight: 500;
      padding: 10px 14px;
      cursor: pointer;
      border-bottom: 3px solid transparent;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .r-tab.active { color: #fff; border-bottom-color: #F6A600; }

    .search-zone {
      background: #073590;
      padding: 10px 16px 18px;
    }
    .trip-opts {
      display: flex;
      gap: 18px;
      margin-bottom: 12px;
    }
    .trip-opt {
      color: rgba(255,255,255,0.85);
      font-size: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }
    .trip-opt input { accent-color: #F6A600; }

    .search-row { display: flex; gap: 8px; align-items: stretch; }
    .s-input {
      flex: 1;
      background: #fff;
      border-radius: 5px;
      padding: 8px 14px;
      min-width: 0;
    }
    .s-input label {
      display: block;
      font-size: 10px;
      color: #888;
      margin-bottom: 2px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .s-input span { font-size: 14px; font-weight: 600; color: #1a1a1a; }
    .s-input span.placeholder { color: #aaa; font-weight: 400; }

    .search-btn-wrap { display: flex; flex-direction: column; align-items: stretch; gap: 4px; }
    .search-btn {
      padding: 0 22px;
      height: 52px;
      border: none;
      border-radius: 5px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      background: #F6A600;
      color: #1a1a1a;
      min-width: 90px;
      transition: all 0.15s;
    }

    .focus-ring-bad {
      outline: 2px dotted rgba(255,255,255,0.25);
      outline-offset: 1px;
    }
    .focus-ring-good {
      outline: 3px solid #ffffff;
      outline-offset: 3px;
      box-shadow: 0 0 0 6px rgba(246,166,0,0.55);
    }

    .helper-hint {
      font-size: 10px;
      color: rgba(255,255,255,0.85);
      text-align: center;
      font-style: italic;
    }
    .focus-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(255,255,255,0.12);
      border-radius: 4px;
      padding: 3px 9px;
      font-size: 10px;
      color: #fff;
      margin-top: 7px;
    }

    .result-zone {
      background: #f5f6f8;
      padding: 16px;
      min-height: 110px;
    }
    .result-heading {
      font-size: 15px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 10px;
    }
    .flight-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .flight-card.focus-moved {
      border: 2.5px solid #073590;
      box-shadow: 0 0 0 4px rgba(7,53,144,0.15);
    }
    .f-route { font-size: 14px; font-weight: 600; color: #1a1a1a; }
    .f-info { font-size: 12px; color: #777; margin-top: 2px; }
    .f-price { font-size: 16px; font-weight: 700; color: #073590; }

    .no-result {
      text-align: center;
      padding: 20px;
      color: #aaa;
      font-size: 13px;
    }
    .no-result i { font-size: 30px; display: block; margin-bottom: 7px; }

    .annotation {
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 13px;
      margin-top: 1.25rem;
      display: flex;
      gap: 10px;
      align-items: flex-start;
      line-height: 1.6;
    }
    .annotation.bad { background: #fff0f0; border: 1px solid #f09595; color: #7a1f1f; }
    .annotation.good { background: #f0f8e8; border: 1px solid #97c459; color: #275010; }
    .annotation i { font-size: 20px; margin-top: 1px; flex-shrink: 0; }

    .sim-btn {
      display: block;
      margin: 1rem auto 0;
      padding: 9px 24px;
      background: #073590;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    .sim-btn:hover { background: #052a70; }
    .sim-btn.reset { background: #555; }
    .sim-btn.reset:hover { background: #333; }

    /* Issue table */
    .issue-table-wrap {
      margin-top: 2.5rem;
    }
    .issue-table-wrap h2 {
      font-size: 16px;
      font-weight: 700;
      color: #073590;
      margin-bottom: 1rem;
      padding-bottom: 8px;
      border-bottom: 2px solid #073590;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
    }
    thead th {
      background: #073590;
      color: #fff;
      text-align: left;
      padding: 10px 14px;
      font-weight: 600;
      font-size: 12px;
      letter-spacing: 0.03em;
    }
    tbody td {
      padding: 10px 14px;
      border-bottom: 1px solid #f0f2f5;
      vertical-align: top;
      line-height: 1.5;
      color: #333;
    }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover td { background: #f9fafc; }

    .pill {
      display: inline-block;
      border-radius: 20px;
      padding: 2px 10px;
      font-size: 11px;
      font-weight: 600;
    }
    .pill.problem { background: #fff0f0; color: #a32d2d; border: 1px solid #f09595; }
    .pill.fix { background: #f0f8e8; color: #3b6d11; border: 1px solid #97c459; }
    .pill.why { background: #e6f1fb; color: #0c447c; border: 1px solid #85b7eb; }

    footer {
      text-align: center;
      margin-top: 2.5rem;
      font-size: 12px;
      color: #aaa;
    }
  </style>
</head>
<body>

<div class="container">

  <div class="page-header">
    <div class="badge">Accessibility Prototype · Section 5</div>
    <h1>Ryanair — Keyboard Accessibility Fix</h1>
    <p>Interactive before/after prototype demonstrating the Search button keyboard issue and the proposed fix. Course: Ergonomics &amp; Accessibility.</p>
  </div>

  <!-- Toggle -->
  <div class="toggle-bar">
    <button class="toggle-btn active" onclick="show('before')" id="btn-before">
      <span class="dot-bad"></span> Before (broken)
    </button>
    <button class="toggle-btn" onclick="show('after')" id="btn-after">
      <span class="dot-good"></span> After (fixed)
    </button>
  </div>

  <!-- BEFORE -->
  <div class="screen active" id="screen-before">
    <p class="screen-label">User tabs to Search → presses <span class="kbd">Enter</span> → nothing happens</p>

    <div class="browser-frame">
      <div class="browser-bar">
        <div class="browser-dots">
          <div class="bdot r"></div><div class="bdot y"></div><div class="bdot g"></div>
        </div>
        <div class="browser-url">🔒 ryanair.com/ie/en</div>
      </div>

      <div class="ryanair-nav">
        <div class="r-tab active"><i class="ti ti-plane" aria-hidden="true"></i> Flights</div>
        <div class="r-tab"><i class="ti ti-car" aria-hidden="true"></i> Car hire</div>
        <div class="r-tab"><i class="ti ti-building" aria-hidden="true"></i> Hotels</div>
      </div>

      <div class="search-zone">
        <div class="trip-opts">
          <label class="trip-opt"><input type="radio" name="tb" checked> Return trip</label>
          <label class="trip-opt"><input type="radio" name="tb"> One way</label>
          <label class="trip-opt"><input type="radio" name="tb"> Multicity</label>
        </div>
        <div class="search-row">
          <div class="s-input">
            <label>From</label>
            <span>Dublin</span>
          </div>
          <div class="s-input">
            <label>To</label>
            <span class="placeholder">Destination</span>
          </div>
          <button class="search-btn focus-ring-bad" tabindex="-1">Search</button>
        </div>
        <div>
          <span class="focus-tag">
            <i class="ti ti-keyboard" aria-hidden="true"></i>
            Keyboard focus is here — Enter was pressed
          </span>
        </div>
      </div>

      <div class="result-zone">
        <div class="no-result">
          <i class="ti ti-keyboard-off" aria-hidden="true"></i>
          No response — Enter key did nothing.<br>User is forced to use the mouse.
        </div>
      </div>
    </div>

    <div class="annotation bad">
      <i class="ti ti-circle-x" aria-hidden="true"></i>
      <div>
        <strong>Problem:</strong> The Search button visually shows focus (faint dotted outline) but pressing <span class="kbd">Enter</span> or <span class="kbd">Space</span> does not trigger the search. This is a <strong>high severity</strong> blocker — keyboard-only users cannot complete the journey without switching to a mouse.
      </div>
    </div>
  </div>

  <!-- AFTER -->
  <div class="screen" id="screen-after">
    <p class="screen-label">User tabs to Search → presses <span class="kbd">Enter</span> → search activates &amp; focus moves</p>

    <div class="browser-frame">
      <div class="browser-bar">
        <div class="browser-dots">
          <div class="bdot r"></div><div class="bdot y"></div><div class="bdot g"></div>
        </div>
        <div class="browser-url">🔒 ryanair.com/ie/en</div>
      </div>

      <div class="ryanair-nav">
        <div class="r-tab active"><i class="ti ti-plane" aria-hidden="true"></i> Flights</div>
        <div class="r-tab"><i class="ti ti-car" aria-hidden="true"></i> Car hire</div>
        <div class="r-tab"><i class="ti ti-building" aria-hidden="true"></i> Hotels</div>
      </div>

      <div class="search-zone">
        <div class="trip-opts">
          <label class="trip-opt"><input type="radio" name="ta" checked> Return trip</label>
          <label class="trip-opt"><input type="radio" name="ta"> One way</label>
          <label class="trip-opt"><input type="radio" name="ta"> Multicity</label>
        </div>
        <div class="search-row">
          <div class="s-input">
            <label>From</label>
            <span>Dublin</span>
          </div>
          <div class="s-input">
            <label>To</label>
            <span>Amsterdam</span>
          </div>
          <div class="search-btn-wrap">
            <button class="search-btn focus-ring-good" tabindex="-1">Search</button>
            <span class="helper-hint">Press Enter or Space to search</span>
          </div>
        </div>
        <div>
          <span class="focus-tag" id="focus-tag-after">
            <i class="ti ti-keyboard" aria-hidden="true"></i>
            <span id="focus-tag-text">Keyboard focus is on Search button</span>
          </span>
        </div>
      </div>

      <div class="result-zone" id="result-zone">
        <div class="no-result" id="result-placeholder">
          <i class="ti ti-search" aria-hidden="true"></i>
          Click the button below to simulate pressing <span class="kbd">Enter</span>
        </div>
        <div id="result-content" style="display:none;">
          <div class="result-heading" id="result-heading">
            <i class="ti ti-plane-departure" aria-hidden="true" style="color:#073590;margin-right:6px;"></i>
            Flight results
          </div>
          <div class="flight-card focus-moved" id="flight-card">
            <div>
              <div class="f-route">Dublin → Amsterdam</div>
              <div class="f-info">13 Jun – 27 Jun · 1 passenger · Return</div>
            </div>
            <div class="f-price">from €29.99</div>
          </div>
        </div>
      </div>
    </div>

    <div class="annotation good">
      <i class="ti ti-circle-check" aria-hidden="true"></i>
      <div>
        <strong>Fix applied (3 improvements):</strong><br>
        1. <strong>Visible focus ring</strong> — strong white outline + amber glow so the user always sees where focus is.<br>
        2. <strong>Enter/Space activation</strong> — the button now responds to keyboard input correctly.<br>
        3. <strong>Focus management</strong> — after search, focus moves automatically to "Flight results" heading so the user knows the action worked.
      </div>
    </div>

    <button class="sim-btn" id="sim-btn" onclick="simulate()">
      ⌨ Simulate pressing Enter on Search
    </button>
  </div>

  <!-- Issue summary table -->
  <div class="issue-table-wrap">
    <h2>Prototype Direction Summary</h2>
    <table>
      <thead>
        <tr>
          <th>Current problem</th>
          <th>Proposed improvement</th>
          <th>Why this improves accessibility</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span class="pill problem">Problem</span><br><br>The Search button visually receives focus but does not submit the search when Enter is pressed.</td>
          <td><span class="pill fix">Fix</span><br><br>Redesign the focused Search button with a clear focus state and keyboard activation behaviour.</td>
          <td><span class="pill why">Why</span><br><br>Keyboard users expect Enter or Space to activate focused buttons. This allows the journey to continue without a mouse.</td>
        </tr>
        <tr>
          <td><span class="pill problem">Problem</span><br><br>The user is forced to switch to mouse at a critical point in the journey.</td>
          <td><span class="pill fix">Fix</span><br><br>Add a visible helper hint "Press Enter to search" only if useful, but the main fix is correct button behaviour.</td>
          <td><span class="pill why">Why</span><br><br>Reduces confusion and supports users who rely on keyboard navigation.</td>
        </tr>
        <tr>
          <td><span class="pill problem">Problem</span><br><br>The failure happens before the booking results are shown.</td>
          <td><span class="pill fix">Fix</span><br><br>Ensure focus moves to the results heading or first flight option after search is submitted.</td>
          <td><span class="pill why">Why</span><br><br>Good focus management confirms that the action worked and places the user at the next logical step.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <footer>
    Ryanair Website Accessibility Audit · Ergonomics &amp; Accessibility · Keyboard-only Testing Report · 28 May 2026
  </footer>

</div>

<script>
  function show(which) {
    document.getElementById('screen-before').classList.toggle('active', which === 'before');
    document.getElementById('screen-after').classList.toggle('active', which === 'after');
    document.getElementById('btn-before').classList.toggle('active', which === 'before');
    document.getElementById('btn-after').classList.toggle('active', which === 'after');
  }

  var simDone = false;
  function simulate() {
    var btn = document.getElementById('sim-btn');
    if (simDone) {
      simDone = false;
      document.getElementById('result-placeholder').style.display = '';
      document.getElementById('result-content').style.display = 'none';
      document.getElementById('focus-tag-text').textContent = 'Keyboard focus is on Search button';
      btn.textContent = '⌨ Simulate pressing Enter on Search';
      btn.classList.remove('reset');
      return;
    }
    simDone = true;
    document.getElementById('result-placeholder').style.display = 'none';
    document.getElementById('result-content').style.display = '';
    document.getElementById('focus-tag-text').textContent = 'Focus moved → Flight results heading';
    btn.textContent = '↩ Reset simulation';
    btn.classList.add('reset');
  }
</script>
</body>
</html>
